	)
	(text "R45 calculations\nFrom OPA381 datasheet, we're given Rp = -Vs/500 micro A\n\nIn our case, Vs= 3V3\n\nRp = 3V3/500 micro A = 6600 ohms"
		(exclude_from_sim no)
		(at 199.644 46.228 0)
